# Local dev env for the EDGAR Intelligence Platform. Copy to .env (gitignored).

# --- Lakebase (Postgres) — dedicated instance: zdsteele-capstone ------------
# In the zdsteele-capstone Lakebase project: Connect -> Copy snippet, then Copy
# OAuth token and paste it as the password right after the role, before the '@':
#   postgresql://zacharysteele8%40gmail.com:<TOKEN>@ep-lingering-recipe-d1fitihp.database.us-west-2.cloud.databricks.com/databricks_postgres?sslmode=require
# The token lasts ~1 hour — regrab it when a dev session goes stale.
LAKEBASE_URL=postgresql://zacharysteele8%40gmail.com:<oauth-token>@ep-lingering-recipe-d1fitihp.database.us-west-2.cloud.databricks.com/databricks_postgres?sslmode=require
LAKEBASE_SCHEMA=edgar
LAKEBASE_INSTANCE=zdsteele-capstone

# --- Databricks auth for the SQL warehouse (Gold/Silver reads) + LLM --------
# Option A (PAT / CLI): set DATABRICKS_CONFIG_PROFILE after `databricks auth login`.
# Option B (service principal M2M): set the three vars below. Use this if PATs
# are disabled for your org (the SDK's Config picks them up automatically).
DATABRICKS_HOST=https://dbc-7b106152-caf3.cloud.databricks.com
# DATABRICKS_CLIENT_ID=<service-principal-app-id>
# DATABRICKS_CLIENT_SECRET=<service-principal-secret>
# DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_WAREHOUSE_ID=b15d3d6f837ba428
UC_CATALOG=bootcamp_students
UC_SCHEMA=zachy_zacharysteele8

# --- Agent -----------------------------------------------------------------
LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Vector Search (leave blank for keyword search on silver_filing_text_chunks)
VS_ENDPOINT=
VS_INDEX=
EMBEDDING_ENDPOINT=databricks-gte-large-en

# --- SEC EDGAR -----------------------------------------------------------
SEC_USER_AGENT=EDGAR Intelligence Platform - Zach Steele zacharysteele8@gmail.com

# --- Flask ---------------------------------------------------------------
FLASK_SECRET_KEY=dev-only-change-me
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8000
