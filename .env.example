# Local dev env for the EDGAR Intelligence Platform. Copy to .env (gitignored).

# --- Lakebase (Postgres) — dedicated instance: zdsteele-capstone ------------
# In the zdsteele-capstone Lakebase project: Connect -> Copy snippet for the URL,
# Copy OAuth token for the password (lasts ~1 hour, regrab when stale).
# Host looks like ep-xxxx.database.<region>.cloud.databricks.com
LAKEBASE_URL=postgresql://users:<oauth-token>@<zdsteele-capstone-host>.database.<region>.cloud.databricks.com:5432/databricks_postgres?sslmode=require
LAKEBASE_SCHEMA=edgar
LAKEBASE_INSTANCE=zdsteele-capstone

# --- Databricks auth for the SQL warehouse (Gold/Silver reads) --------------
DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_WAREHOUSE_ID=b15d3d6f837ba428
UC_CATALOG=bootcamp_students
UC_SCHEMA=zachy_zacharysteele8

# --- Agent -----------------------------------------------------------------
LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Vector Search (leave blank for keyword search on silver_filing_text_chunks)
VS_ENDPOINT=
VS_INDEX=
EMBEDDING_ENDPOINT=databricks-gte-large-en

# --- SEC EDGAR -----------------------------------------------------------
SEC_USER_AGENT=EDGAR Intelligence Platform - Zach Steele zacharysteele8@gmail.com

# --- Flask ---------------------------------------------------------------
FLASK_SECRET_KEY=dev-only-change-me
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8000
