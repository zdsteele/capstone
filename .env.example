# Local dev env for the EDGAR Intelligence Platform. Copy to .env (gitignored).
# Full walkthrough: docs/SETUP.md

# --- Lakebase (Postgres) — autoscaling project zdsteele-capstone -----------
# Use the native-password role `edgar_app` (created once, see docs/SETUP.md §2),
# NOT the 1-hour OAuth token. Host is the branch's read-write endpoint.
LAKEBASE_URL=postgresql://edgar_app:<password>@ep-lingering-recipe-d1fitihp.database.us-west-2.cloud.databricks.com/databricks_postgres?sslmode=require
LAKEBASE_SCHEMA=edgar
LAKEBASE_INSTANCE=zdsteele-capstone

# --- Databricks auth — SQL warehouse (Gold/Silver reads) + the LLM ---------
# Service-principal M2M (PATs are disabled in this org). The SDK's Config picks
# these up automatically; the same SP should be in your ~/.databrickscfg [edgar]
# profile for the CLI.
DATABRICKS_HOST=https://dbc-7b106152-caf3.cloud.databricks.com
DATABRICKS_CLIENT_ID=<service-principal-app-id>
DATABRICKS_CLIENT_SECRET=<service-principal-secret>
DATABRICKS_WAREHOUSE_ID=b15d3d6f837ba428
UC_CATALOG=bootcamp_students
UC_SCHEMA=zdsteele_capstone

# --- Agent -----------------------------------------------------------------
LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Vector Search — built by notebook 05 (blank both = keyword-ILIKE fallback)
VS_ENDPOINT=zachy_vs
VS_INDEX=bootcamp_students.zdsteele_capstone.filing_text_index
EMBEDDING_ENDPOINT=databricks-gte-large-en

# --- SEC EDGAR -----------------------------------------------------------
SEC_USER_AGENT=EDGAR Intelligence Platform - Zach Steele zacharysteele8@gmail.com

# --- Flask ---------------------------------------------------------------
FLASK_SECRET_KEY=dev-only-change-me
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8000
# 1 = local dev: auto-reload on save + in-browser tracebacks. Leave unset when deployed.
FLASK_DEBUG=1
